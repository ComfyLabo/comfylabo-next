NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
COMFYLABO_ARTICLE_SLUG=your-article-slug

# 接続先確認と事前承認まではfalseのままにする
COMFYLABO_DEPLOY_ENABLED=false
COMFYLABO_AUTO_DEPLOY=false
XSERVER_HOST=your-server.xsrv.jp
XSERVER_USER=your-server-id
XSERVER_PORT=10022
# ローカルで既存の秘密鍵ファイルを使う場合の絶対パス。鍵本体やパスワードは書かない。
XSERVER_SSH_KEY_PATH=
XSERVER_KNOWN_HOSTS_PATH=
XSERVER_RELEASE_ROOT=/home/your-server-id/comfylabo-next

# 既存Next.js Studioを本番モードで使用する場合は別途設定
# STUDIO_USERNAME=
# STUDIO_PASSWORD=
