{
  "name": "sanity-blog-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "site:build": "node scripts/site.mjs",
    "site:verify": "node scripts/verify-site.mjs",
    "mvp:articles": "node scripts/mvp-content.mjs list",
